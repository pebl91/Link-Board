# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Bundler
/.bundle

# Gems
/vendor/bundle

# Logs
/log/*
!/log/.keep

# Temporary files
/tmp/*
!/tmp/.keep

# PID files
/tmp/pids/*
!/tmp/pids/

# Cache
/tmp/cache/*
!/tmp/cache/.keep

# Storage (Active Storage)
/storage/*
!/storage/.keep

# Uploaded files
/public/uploads

# SQLite database
/db/*.sqlite3
/db/*.sqlite3-*
/db/*.db

# Master key (DO NOT COMMIT)
/config/master.key

# Credentials
/config/credentials/*.key

# Environment variables
.env
.env.*
!.env.example

# Node
/node_modules

# Yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# JavaScript build artifacts
/public/assets
/public/packs
/public/packs-test

# Bootsnap
/tmp/cache
/bootsnap

# Coverage
/coverage

# Test artifacts
/capybara-*.html
/screenshots

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Linux
.directory

# Ruby version managers
.ruby-version.local
.ruby-gemset

# Byebug history
.byebug_history

# Pry history
.pry_history

# RSpec
.rspec_status

# Debug
debug.log